# Copie ce fichier en ".env" en local, ou renseigne ces valeurs
# dans l'onglet "Variables" de Railway (ne jamais commit le .env sur GitHub).

DISCORD_TOKEN=colle_ton_token_ici
GUILD_ID=id_du_serveur_bordeaux_rp

# Rôle du staff, ajouté automatiquement à chaque ticket créé
STAFF_ROLE_ID=id_du_role_staff

# Les 3 CATÉGORIES Discord (clic droit sur la catégorie de salons > Copier l'ID)
REPORT_CATEGORY_ID=id_categorie_ouverture_de_dossier
QUESTION_CATEGORY_ID=id_categorie_question
OFFICER_CATEGORY_ID=id_categorie_demande_officier

# Optionnel : lien Twitch/YouTube réel pour garantir l'affichage du badge "En direct"
STREAM_URL=
